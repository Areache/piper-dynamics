<?xml version="1.0"?>
<robot name="toy6">
  <link name="base_link">
    <inertial><mass value="1.0"/><origin xyz="0 0 0.05"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <link name="link1">
    <inertial><mass value="0.6"/><origin xyz="0.0 0.0 0.06"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="3.0"/>
  </joint>
  <link name="link2">
    <inertial><mass value="0.8"/><origin xyz="0.0 0.0 0.14"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial>
    <!-- Collision geometry on link2 and link3 only, so the feasibility tests
         see both box sources (mesh and kinematic-fallback). -->
    <collision><origin xyz="0 0 0.14"/><geometry><box size="0.06 0.06 0.32"/></geometry></collision>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="3.0"/>
  </joint>
  <link name="link3">
    <inertial><mass value="0.55"/><origin xyz="0.0 0.0 0.12"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial>
    <collision><origin xyz="0 0 0.125"/>
      <geometry><cylinder radius="0.03" length="0.27"/></geometry></collision>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="3.0"/>
  </joint>
  <link name="link4">
    <inertial><mass value="0.3"/><origin xyz="0.0 0.0 0.08"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="3.0"/>
  </joint>
  <link name="link5">
    <inertial><mass value="0.2"/><origin xyz="0.0 0.0 0.06"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="joint5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="3.0"/>
  </joint>
  <link name="link6">
    <inertial><mass value="0.1"/><origin xyz="0.0 0.0 0.03"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="joint6" type="revolute">
    <parent link="link5"/><child link="link6"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="3.0"/>
  </joint>
</robot>
